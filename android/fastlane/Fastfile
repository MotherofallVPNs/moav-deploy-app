default_platform(:android)

# Paths are anchored to this file so lanes behave the same from any cwd.
REPO_ROOT = File.expand_path("../..", __dir__)
AAB_PATH = File.join(REPO_ROOT, "build/app/outputs/bundle/release/app-release.aab")
METADATA_PATH = File.join(REPO_ROOT, "fastlane/metadata/android")

def play_json_key
  path = ENV["PLAY_SERVICE_ACCOUNT_JSON_PATH"].to_s
  UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON_PATH is not set") if path.empty?
  UI.user_error!("No service-account JSON at #{path}") unless File.file?(path)
  path
end

def pubspec_version_code
  pubspec = File.read(File.join(REPO_ROOT, "pubspec.yaml"))
  match = pubspec.match(/^version:\s*\S+\+(\d+)\s*$/)
  UI.user_error!("Could not read versionCode from pubspec.yaml") unless match
  match[1]
end

# supply prefers <versionCode>.txt and falls back to default.txt; log which applies.
def report_changelog(version_code)
  dir = File.join(METADATA_PATH, "en-US/changelogs")
  specific = File.join(dir, "#{version_code}.txt")
  default = File.join(dir, "default.txt")
  chosen = File.file?(specific) ? specific : default
  UI.user_error!("No changelog at #{chosen}") unless File.file?(chosen)
  UI.message("Play release notes (en-US) from #{chosen}:")
  UI.message(File.read(chosen).strip)
end

platform :android do
  desc "Upload the signed AAB to the Play closed testing track with changelog and listing"
  lane :closed_testing do
    json_key = play_json_key
    UI.user_error!("AAB not found at #{AAB_PATH}; run `flutter build appbundle --release`") unless File.file?(AAB_PATH)
    report_changelog(pubspec_version_code)

    validate_play_store_json_key(json_key: json_key)
    upload_to_play_store(
      track: "alpha",
      aab: AAB_PATH,
      json_key: json_key,
      metadata_path: METADATA_PATH,
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end

  desc "Promote the current closed testing build to open testing (manual use only)"
  lane :promote_to_open do
    json_key = play_json_key
    validate_play_store_json_key(json_key: json_key)
    upload_to_play_store(
      track: "alpha",
      track_promote_to: "beta",
      track_promote_release_status: "completed",
      json_key: json_key,
      metadata_path: METADATA_PATH,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Promote the current open testing build to production (manual use only)"
  lane :promote_production do
    json_key = play_json_key
    validate_play_store_json_key(json_key: json_key)
    upload_to_play_store(
      track: "beta",
      track_promote_to: "production",
      track_promote_release_status: "completed",
      json_key: json_key,
      metadata_path: METADATA_PATH,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Push the store listing text (title, descriptions) for all locales (manual use only)"
  lane :sync_listing do
    json_key = play_json_key
    validate_play_store_json_key(json_key: json_key)
    upload_to_play_store(
      json_key: json_key,
      metadata_path: METADATA_PATH,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end

# ---------------------------------------------------------------------------
# iOS / TestFlight
#
# Signing uses fastlane match: the Apple Distribution certificate, its private
# key and the App Store provisioning profile for the bundle id live encrypted
# in the private repo MotherofallVPNs/moav-deploy-match (branch main). The lane
# authenticates to App Store Connect with an API key and installs the signing
# material into a dedicated keychain (moav-deploy-ios) whose password the lane
# knows, so codesign never blocks on the macOS keychain permission dialog; the
# login keychain is left alone.
#   - Locally, match runs read-write: it reuses the stored certificate and
#     regenerates the profile only if it is missing or invalid (needs push
#     access to the match repo and MATCH_PASSWORD).
#   - In CI (release.yml, macOS job) match runs read-only over SSH with a
#     deploy key; it never creates anything, so a missing or expired item
#     fails loudly instead of minting a second certificate.
# The Xcode project stays on automatic signing in git: the lane flips the Runner
# target to manual signing only for the duration of the archive and restores the
# pristine project.pbxproj afterwards, so a lane run never leaves a diff behind.
#
# Build number: the pubspec `+N` is the floor. If TestFlight already has a build
# with that number for this version (a re-run, or a release cut without a bump)
# the lane uses latest TestFlight build + 1, so an upload never collides.
#
# Env (defaults match the owner's Mac; override for other machines / CI):
#   ASC_KEY_ID             App Store Connect API key id
#   ASC_ISSUER_ID          App Store Connect issuer id
#   ASC_KEY_PATH           path to the AuthKey_<id>.p8 (never committed)
#   ASC_TEAM_ID            Apple team id (optional; defaults to the project's)
#   MATCH_PASSWORD         passphrase of the match repo
#   MATCH_GIT_PRIVATE_KEY  (CI) path to the deploy key for the match repo;
#                          unset locally, where your own SSH key is used
#   IOS_KEYCHAIN_PASSWORD  password of the signing keychain; when unset a random
#                          one is generated once and kept in the login keychain
# ---------------------------------------------------------------------------
require "open3"
require "securerandom"

IOS_DIR = File.join(REPO_ROOT, "ios")
IOS_PROJECT = File.join(IOS_DIR, "Runner.xcodeproj")
IOS_WORKSPACE = File.join(IOS_DIR, "Runner.xcworkspace")
IOS_BUNDLE_ID = "org.motherofallvpns.moavdeploy"
IOS_TEAM_ID = ENV.fetch("ASC_TEAM_ID", "2F556JZ8H9")
IOS_MATCH_GIT_URL = "git@github.com:MotherofallVPNs/moav-deploy-match.git"
IOS_MATCH_GIT_BRANCH = "main"
IOS_IPA_DIR = File.join(REPO_ROOT, "build/ios/ipa")
IOS_METADATA_PATH = File.join(REPO_ROOT, "fastlane/metadata/ios")
IOS_KEYCHAIN_PATH = File.join(Dir.home, "Library/Keychains/moav-deploy-ios.keychain-db")
IOS_KEYCHAIN_SECRET_SERVICE = "moav-deploy-ios-keychain"

def ios_keychain_password
  from_env = ENV["IOS_KEYCHAIN_PASSWORD"].to_s
  return from_env unless from_env.empty?
  stored, status = Open3.capture2("security", "find-generic-password", "-s", IOS_KEYCHAIN_SECRET_SERVICE, "-w", err: File::NULL)
  return stored.strip if status.success? && !stored.strip.empty?
  password = SecureRandom.hex(24)
  ok = system("security", "add-generic-password", "-s", IOS_KEYCHAIN_SECRET_SERVICE, "-a", "fastlane", "-w", password)
  UI.user_error!("Could not store the signing keychain password in the login keychain") unless ok
  UI.message("Generated a password for #{IOS_KEYCHAIN_PATH}; stored in the login keychain as '#{IOS_KEYCHAIN_SECRET_SERVICE}'")
  password
end

# Creates (first run) and unlocks the dedicated signing keychain, keeping it in
# the search list so xcodebuild/codesign can find the distribution identity.
def ensure_ios_keychain
  password = ios_keychain_password
  unless File.exist?(IOS_KEYCHAIN_PATH)
    create_keychain(path: IOS_KEYCHAIN_PATH, password: password, default_keychain: false,
                    unlock: true, timeout: 3600, lock_when_sleeps: false, add_to_search_list: true)
  end
  unlock_keychain(path: IOS_KEYCHAIN_PATH, password: password, add_to_search_list: true, set_default: false)
  password
end

def asc_api_key
  key_path = ENV["ASC_KEY_PATH"].to_s
  UI.user_error!("No App Store Connect API key at #{key_path} (set ASC_KEY_PATH)") unless File.file?(key_path)
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path,
    in_house: false
  )
end

def pubspec_version_name
  pubspec = File.read(File.join(REPO_ROOT, "pubspec.yaml"))
  match = pubspec.match(/^version:\s*(\S+)\+\d+\s*$/)
  UI.user_error!("Could not read version from pubspec.yaml") unless match
  match[1]
end

# Installs the distribution certificate and App Store profile from the match
# repo into the signing keychain and returns the profile name for the archive.
# Read-only on CI (never creates), read-write locally (reuses, regenerates only
# what is missing).
def ios_match_signing(api_key, keychain_password)
  UI.user_error!("MATCH_PASSWORD is not set (passphrase of the match repo)") if ENV["MATCH_PASSWORD"].to_s.empty?
  match(
    type: "appstore",
    platform: "ios",
    readonly: is_ci,
    api_key: api_key,
    git_url: IOS_MATCH_GIT_URL,
    git_branch: IOS_MATCH_GIT_BRANCH,
    app_identifier: IOS_BUNDLE_ID,
    team_id: IOS_TEAM_ID,
    keychain_name: IOS_KEYCHAIN_PATH,
    keychain_password: keychain_password
  )
  profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][IOS_BUNDLE_ID]
  UI.user_error!("match did not return a profile for #{IOS_BUNDLE_ID}") if profile_name.to_s.empty?
  profile_name
end

# pubspec +N, bumped past whatever TestFlight already has for this version.
def ios_build_number(api_key, version_name)
  floor = pubspec_version_code.to_i
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: IOS_BUNDLE_ID,
    team_id: IOS_TEAM_ID,
    version: version_name,
    initial_build_number: 0
  ).to_i
  chosen = [floor, latest + 1].max
  if chosen != floor
    UI.important("TestFlight already has #{version_name} (#{latest}); using build number #{chosen} instead of pubspec #{floor}.")
  end
  chosen
end

platform :ios do
  desc "Fetch the distribution certificate and App Store profile from the match repo into the signing keychain (no build)"
  lane :sync_signing do
    api_key = asc_api_key
    keychain_password = ensure_ios_keychain
    profile_name = ios_match_signing(api_key, keychain_password)
    UI.success("Signing ready in #{IOS_KEYCHAIN_PATH}; profile '#{profile_name}'.")
  end

  desc "Build a signed App Store IPA and upload it to TestFlight (internal testers only, no review submission)"
  lane :beta do
    api_key = asc_api_key
    version_name = pubspec_version_name
    build_number = ios_build_number(api_key, version_name)
    keychain_password = ensure_ios_keychain
    profile_name = ios_match_signing(api_key, keychain_password)

    # Flutter side: dependencies + Generated.xcconfig for a release build, with
    # the chosen build number (Info.plist reads FLUTTER_BUILD_NUMBER). Plugins
    # resolve through Swift Package Manager, so there is no pod install step.
    Dir.chdir(REPO_ROOT) do
      sh("flutter pub get")
      sh("flutter build ios --release --config-only --build-name=#{version_name} --build-number=#{build_number}")
    end

    pbxproj = File.join(IOS_PROJECT, "project.pbxproj")
    pristine_pbxproj = File.read(pbxproj)
    begin
      update_code_signing_settings(
        path: IOS_PROJECT,
        targets: ["Runner"],
        use_automatic_signing: false,
        team_id: IOS_TEAM_ID,
        code_sign_identity: "Apple Distribution",
        sdk: "iphoneos*",
        profile_name: profile_name,
        bundle_identifier: IOS_BUNDLE_ID
      )
      build_app(
        workspace: IOS_WORKSPACE,
        scheme: "Runner",
        configuration: "Release",
        clean: true,
        export_method: "app-store",
        export_team_id: IOS_TEAM_ID,
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { IOS_BUNDLE_ID => profile_name }
        },
        output_directory: IOS_IPA_DIR,
        output_name: "moav-deploy-#{version_name}-#{build_number}.ipa",
        include_bitcode: false,
        include_symbols: true
      )
    ensure
      File.write(pbxproj, pristine_pbxproj)
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false
    )
    UI.success("Uploaded #{version_name} (#{build_number}) to TestFlight (internal); processing continues on App Store Connect.")
  end

  desc "Push the App Store listing metadata (name, subtitle, description, keywords, URLs) without a binary"
  lane :sync_metadata do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      team_id: IOS_TEAM_ID,
      metadata_path: IOS_METADATA_PATH,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true
    )
    UI.success("App Store metadata pushed from #{IOS_METADATA_PATH}.")
  end
end
