<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window shown until Flutter draws its first frame: MoaV dark
     background with the adaptive-icon mark centred. A designed splash is a
     follow-up (issue #27, "Designed launch/splash screen"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
